CI_ENVIRONMENT = development

app.baseURL = 'http://localhost/blax_inventory/public/'

database.default.hostname = localhost
database.default.database = blax_marketplace
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# COHERE (AI SEMANTIC PRODUCT SEARCH)
#--------------------------------------------------------------------
# Server-side only. Never expose this value to the browser.
COHERE_API_KEY = your_cohere_api_key_here

# Optional tuning (defaults live in app/Config/Cohere.php)
cohere.enabled  = true
cohere.model    = embed-v4.0 
cohere.minScore = 0.22
cohere.relativeCutoff = 0.80
cohere.chatEnabled = true
cohere.chatModel = command-a-03-2025

# Tenant verification email (fill these values in the deployment environment)
email.fromName = 'RHK General Merchandise'
email.protocol = smtp
email.SMTPPort = 587
email.SMTPCrypto = tls
email.fromEmail = your_email@example.com
email.SMTPHost = smtp.gmail.com
email.SMTPUser = your_email@example.com
email.SMTPPass = your_app_password_here

#--------------------------------------------------------------------
# PAYMONGO API CONFIGURATION
#--------------------------------------------------------------------
# PayMongo API credentials (use pk_test_... and sk_test_... in development)
PAYMONGO_PUBLIC_KEY = pk_test_your_public_key_here
PAYMONGO_SECRET_KEY = sk_test_your_secret_key_here
PAYMONGO_WEBHOOK_SECRET = whsec_your_webhook_secret_here

#--------------------------------------------------------------------
# TEXTBEE SMS GATEWAY CONFIGURATION
#--------------------------------------------------------------------
TEXTBEE_API_KEY = "your_textbee_api_key_here"
TEXTBEE_DEVICE_ID = "your_textbee_device_id_here"
TEXTBEE_BASE_URL = "https://api.textbee.dev/api/v1"

#--------------------------------------------------------------------
# GOOGLE MAPS PLATFORM
#--------------------------------------------------------------------
# Used for Maps JS API, Geocoding API, Routes API, Places API (New).
# Restrict this key in Google Cloud Console to your domain and these 4 APIs only.
GOOGLE_MAPS_API_KEY = your_google_maps_api_key_here

