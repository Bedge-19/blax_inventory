#--------------------------------------------------------------------
# OPERATING SYSTEM JUNK FILES
#--------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# Windows Installers
*.cab
*.msi
*.msm
*.msp

#--------------------------------------------------------------------
# ENVIRONMENT & CREDENTIAL FILES (SECURITY SENSITIVE)
#--------------------------------------------------------------------
# Never commit real environment variables, secret keys, or local credentials.
.env
.env.*
!.env.example
!.env*.example
env
.env.local
.env.*.local

# Local credentials, certificates, and private keys
*.key
*.pem
*.crt
*.pfx
*.pkcs12
*.cert
credentials.json
client_secret*.json
service_account*.json
id_rsa
id_rsa.pub

# Vagrant
.vagrant
Vagrantfile

#--------------------------------------------------------------------
# DEPENDENCIES & PACKAGE MANAGERS
#--------------------------------------------------------------------
/system/
/vendor/
vendor/
/node_modules/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

#--------------------------------------------------------------------
# STORAGE, CACHE & TEMPORARY DIRECTORIES
#--------------------------------------------------------------------
# CodeIgniter 4 writable storage
/writable/cache/*
!/writable/cache/.gitkeep
!/writable/cache/index.html
/writable/debugbar/*
!/writable/debugbar/.gitkeep
!/writable/debugbar/index.html
/writable/logs/*
!/writable/logs/.gitkeep
!/writable/logs/index.html
/writable/session/*
!/writable/session/.gitkeep
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/.gitkeep
!/writable/uploads/index.html

# Generic / Laravel storage & log directories
/storage/
storage/
/storage/logs/
/storage/framework/
/storage/logs
/storage/framework
storage/logs/
storage/framework/
storage/cache/

# Logs & temp files
*.log
php_errors.log
.cache/
tmp/

#--------------------------------------------------------------------
# USER UPLOADS (Ignore dynamic uploads, keep folder structure)
#--------------------------------------------------------------------
public/uploads/**
!public/uploads/**/
!public/uploads/**/.gitkeep
!public/uploads/.gitkeep

#--------------------------------------------------------------------
# DATABASE DUMPS & LOCAL BACKUPS
#--------------------------------------------------------------------
*.sql
*.sql.gz
*.sqlite
*.db

#--------------------------------------------------------------------
# BUILD & TEST ARTIFACTS
#--------------------------------------------------------------------
build/
dist/
user_guide_src/build/*
user_guide_src/cilexer/build/*
user_guide_src/cilexer/dist/*
user_guide_src/cilexer/pycilexer.egg-info/*
tests/coverage*
phpunit
/results/
/phpunit*.xml

#--------------------------------------------------------------------
# AI / ASSISTANT TOOLING & SCRATCHPADS
#--------------------------------------------------------------------
.claude/
.gemini/
.agents/

#--------------------------------------------------------------------
# IDE & DEVELOPMENT CONFIGURATIONS
#--------------------------------------------------------------------
# JetBrains (PhpStorm, etc.)
.idea/
*.iml

# Visual Studio Code
.vscode/

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project
.phpintel

# NetBeans
nbproject/
nbbuild/
nbdist/
nbactions.xml
nb-configuration.xml
.nb-gradle/

# PHP tooling
.php-version
_modules/*
# /api/
!/api/index.php
